# ==============================================================================
# Astra AI Central Backend — Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Database Connection (Render PostgreSQL or local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astra_ai

# Security & Authentication
# Generate with: npm run hash-password -- "your-secure-password"
ASTRA_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$example_salt$example_hash
# JWT Secret (minimum 32 characters random string)
ASTRA_JWT_SECRET=replace_with_a_super_secret_32_character_minimum_random_key
# Access token expiration in seconds (default: 900 = 15 minutes)
ACCESS_TOKEN_EXPIRY_SECONDS=900
# Refresh token expiration in days (default: 30 days)
REFRESH_TOKEN_EXPIRY_DAYS=30

# Rate Limiting & Brute Force Protection
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# AI Provider Credentials (Backend-only, never sent to clients)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_NIM_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
