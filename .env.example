# ==============================================================================
# Astra AI Central Backend — Environment Configuration (Phase 6 Simplified)
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=production
LOG_LEVEL=info

# Single-User Authentication (Required in production)
# Set your secure application access password here:
AUTH_PASSWORD=your_secure_password_here

# Rate Limiting & Protection
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=120

# AI Provider Credentials (Backend-only, never sent to clients)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_NIM_API_KEY=
TOGETHER_API_KEY=
DEEPINFRA_API_KEY=
